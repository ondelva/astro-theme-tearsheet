---
// A plain HTML form, no script. Where it posts comes from src/lib/subscribe-target.ts.
import { subscribeTarget } from '../../lib/subscribe-target';

interface Props {
  button?: string;
  id?: string; // unique per page when the form appears twice
}
const { button = 'Subscribe', id = 'subscribe-email' } = Astro.props;
const target = subscribeTarget();
---

<form
  action={target.action}
  method={target.method}
  target={target.newTab ? '_blank' : undefined}
  class="subscribe-form"
>
  {Object.entries(target.hidden).map(([name, value]) => (
    <input type="hidden" {name} {value} />
  ))}
  <label for={id} class="sr-only">
    Email address
  </label>
  <input
    id={id}
    type="email"
    name={target.emailField}
    required
    autocomplete="email"
    placeholder="you@company.com"
  />
  <button type="submit" class="font-ui">
    {button}
  </button>
</form>

<style>
  .subscribe-form {
    display: flex;
    flex-wrap: wrap;
    gap: 0.5rem;
  }
  input {
    flex: 1 1 12rem;
    min-width: 0;
    padding: 0.625rem 0.75rem;
    border: 1px solid var(--foreground);
    background: var(--background);
  }
  button {
    padding: 0.625rem 1rem;
    font-weight: 700;
    background: var(--primary);
    color: var(--on-primary);
    cursor: pointer;
    transition: background-color var(--transition-fast);
  }
  button:hover {
    background: var(--primary-hover);
  }
</style>
