---
// Archive rows: number, title, free/members meter, date. Shared by home and the archive.
import { formatDate, issueHref, type Issue } from '../../lib/issues';

interface Props {
  issues: Issue[];
}
const { issues } = Astro.props;
---

<ol class="ledger font-ui tabular-nums">
  {issues.map((issue) => (
    <li>
      <span class="text-primary font-extrabold">{issue.number}</span>
      <a href={issueHref(issue)} class="text-[1.0625rem] text-pretty no-underline hover:underline">
        {issue.data.title}
      </a>
      <span class="meter" style={`--read: ${issue.cut.freeShare}%`}>
        <span class="sr-only">
          {issue.cut.members ? `Members issue, ${issue.cut.freeShare}% free` : 'Free issue'}
        </span>
      </span>
      <time class="text-muted text-sm" datetime={issue.data.date.toISOString()}>
        {formatDate(issue.data.date)}
      </time>
    </li>
  ))}
</ol>

<style>
  li {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) 5rem 6rem;
    gap: 0.75rem;
    align-items: baseline;
    padding-block: 0.625rem;
    border-top: 1px solid var(--border);
  }
  li:last-child {
    border-bottom: 1px solid var(--border);
  }
  .meter {
    height: 4px;
    align-self: center;
  }
  time {
    text-align: end;
  }
  @media (max-width: 40rem) {
    li {
      grid-template-columns: 2.5rem minmax(0, 1fr) 3rem;
    }
    time {
      display: none;
    }
  }
</style>
