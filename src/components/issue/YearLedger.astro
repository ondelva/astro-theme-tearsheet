---
// Ledger grouped by year, the year hanging in the issue-number column. Archive and topic pages.
import Ledger from './Ledger.astro';
import type { Issue } from '../../lib/issues';

interface Props {
  issues: Issue[]; // newest first
}
const years = Map.groupBy(Astro.props.issues, (issue) => issue.data.date.getUTCFullYear());
---

{[...years].map(([year, issues]) => (
  <section aria-labelledby={`y${year}`} class="year">
    <h2
      id={`y${year}`}
      class="font-ui text-primary text-4xl leading-none font-extrabold tabular-nums"
    >
      {year}
    </h2>
    <div class="max-w-content min-w-0">
      <Ledger issues={issues} />
    </div>
  </section>
))}

<style>
  .year {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0.75rem 1.75rem;
    margin-top: 3rem;
  }
  @media (max-width: 40rem) {
    .year {
      grid-template-columns: 1fr;
    }
  }
</style>
