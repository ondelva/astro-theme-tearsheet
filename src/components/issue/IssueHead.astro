---
// The hanging grid: the issue number in its own column, everything else beside it.
// Below 40rem the number drops above the title on one line with its week label.
import { formatDate, issueHref, topicHref, type Issue } from '../../lib/issues';
import { readingMinutes } from '../../lib/cut';

interface Props {
  issue: Issue;
  as?: 'h1' | 'h2';
  link?: boolean; // title links to the issue (home); off on the issue page itself
}
const { issue, as: Heading = 'h2', link = false } = Astro.props;
const { title, dek, date, topics } = issue.data;
---

<article class="issue-grid">
  <p class="issue-no font-ui tabular-nums">
    {issue.number}
    <small>
      {issue.week} · {issue.cut.members ? 'Members' : 'Free'}
    </small>
  </p>
  <div class="min-w-0">
    <Heading class="text-3xl leading-[1.08] font-bold sm:text-4xl">
      {link ? (
        <a href={issueHref(issue)} class="hover:underline">
          {title}
        </a>
      ) : (
        title
      )}
    </Heading>
    <p class="text-muted max-w-content mt-2 text-lg italic sm:text-xl">{dek}</p>
    <p class="font-ui text-muted mt-3 text-[0.9375rem]">
      <time datetime={date.toISOString()}>{formatDate(date)}</time>
      {' · '}
      {readingMinutes(issue.cut.totalWords)} min
      {topics.map((topic) => (
        <>
          {' · '}
          <a href={topicHref(topic)} class="underline">
            {topic}
          </a>
        </>
      ))}
    </p>
    <slot />
  </div>
</article>

<style>
  .issue-grid {
    display: grid;
    grid-template-columns: 7rem minmax(0, 1fr);
    gap: 0 1.75rem;
  }
  .issue-no {
    font-size: 4rem;
    line-height: 0.9;
    font-weight: 800;
    color: var(--primary);
  }
  .issue-no small {
    display: block;
    margin-top: 0.5rem;
    font-size: 0.875rem;
    font-weight: 500;
    line-height: 1.4;
    color: var(--muted);
  }
  @media (max-width: 40rem) {
    .issue-grid {
      grid-template-columns: 1fr;
    }
    .issue-no {
      font-size: 3rem;
      margin-bottom: 0.75rem;
    }
    .issue-no small {
      display: inline;
      margin-left: 0.5rem;
    }
  }
</style>
