---
// The signature. On an issue page it closes the free part: heavy rule, words read against the
// whole, the members remainder, and the form. As a teaser (home) it shows the same meter and
// links to the issue. newsletter.theCut = false keeps the removal and prints a plain link instead.
import SubscribeForm from './SubscribeForm.astro';
import { newsletter } from '../../config';
import type { CutStats } from '../../lib/cut';

interface Props {
  cut: CutStats;
  href?: string; // set for the teaser: the meter links to the issue instead of showing the form
}
const { cut, href } = Astro.props;
const n = (x: number) => x.toLocaleString('en');
---

{newsletter.theCut ? (
  <div class="cut" role="note" aria-label="Members-only continuation">
    <p class="cut-meter font-ui tabular-nums">
      <span>
        {href
          ? `${n(cut.freeWords)} of ${n(cut.totalWords)} words free`
          : `You've read ${n(cut.freeWords)} of ${n(cut.totalWords)} words`}
      </span>
      <span class="text-primary">
        {n(cut.membersWords)} words · {cut.membersMinutes} min for members
      </span>
    </p>
    <span class="meter" style={`--read: ${cut.freeShare}%`} aria-hidden="true" />
    {href ? (
      <a href={href} class="font-ui font-bold underline">
        Read the free part
      </a>
    ) : (
      <SubscribeForm button={`Read the rest · ${newsletter.price}`} id="cut-email" />
    )}
  </div>
) : (
  <p class="font-ui mt-6 font-bold">
    <a href={href ?? '/subscribe'} class="underline">
      Continue reading
    </a>
  </p>
)}

{/* The site cannot tell a member from anyone else: members read the issue by email. Say so,
    so a paying reader is not met with only a price. */}
{!href && (
  <p class="font-ui text-muted mt-3 text-[0.9375rem]">
    Already a member? Members get the full issue by email.
  </p>
)}

<style>
  .cut {
    margin-top: 1.5rem;
    border-top: 6px solid var(--foreground);
    padding-top: 0.625rem;
    display: grid;
    gap: 0.875rem;
    justify-items: start;
  }
  .cut > * {
    width: 100%;
  }
  .cut > a {
    width: auto;
  }
  .cut-meter {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 0.25rem 1rem;
    font-weight: 700;
  }
  .cut .meter {
    height: 6px;
  }
</style>
