---
import { nav, site, ui } from '../../config';

const year = new Date().getFullYear();
---

<footer class="border-foreground font-ui mt-24 border-t-[3px]">
  <div class="max-w-wide mx-auto flex flex-wrap gap-x-10 gap-y-6 px-4 py-8 text-sm">
    {nav.footer.map((group) => (
      <nav aria-label={group.title}>
        <h2 class="text-muted font-medium">{group.title}</h2>
        <ul class="mt-2 space-y-1">
          {group.links.map(({ label, href }) => (
            <li>
              <a href={href} class="no-underline hover:underline">
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
    ))}
    <p class="text-muted basis-full">
      {`© ${year} ${site.name}`}
      {' · '}
      <a href="/rss.xml" class="underline">
        {ui.rss}
      </a>
      {' · '}
      <a href="https://github.com/ondelva/astro-theme-tearsheet" class="underline">
        Tearsheet
      </a>{' '}
      theme by ondelva
    </p>
  </div>
</footer>
