---
// Sticky top bar. On the home page the masthead prints the name large, so `home` drops it here.
import ThemeToggle from './ThemeToggle.astro';
import { features, nav, site, ui } from '../../config';

interface Props {
  home?: boolean;
}
const { home = false } = Astro.props;
const here = Astro.url.pathname.replace(/\/$/, '');
---

<header class="bg-background border-border sticky top-0 z-40 border-b">
  <div class="max-w-wide font-ui mx-auto flex flex-wrap items-baseline gap-x-6 gap-y-1 px-4 py-3">
    {!home && (
      <a href="/" class="text-xl leading-none font-extrabold">
        {site.name}
      </a>
    )}
    {/* Nav and toggle wrap as one group, so the toggle never drops to a line of its own */}
    <div class="ms-auto flex items-baseline gap-x-5">
      <nav aria-label={ui.mainNav}>
        <ul class="flex flex-wrap gap-x-5 font-medium">
          {nav.header.map(({ label, href }) => (
            <li>
              <a
                href={href}
                aria-current={here === href ? 'page' : undefined}
                class="aria-[current=page]:text-primary no-underline hover:underline aria-[current=page]:underline"
              >
                {label}
              </a>
            </li>
          ))}
        </ul>
      </nav>
      {features.darkMode && <ThemeToggle />}
    </div>
  </div>
</header>
