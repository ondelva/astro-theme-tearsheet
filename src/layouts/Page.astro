---
// Layout for plain Markdown pages in src/pages (about, privacy, terms): `layout: ../layouts/Page.astro`.
import Base from './Base.astro';

interface Props {
  frontmatter: { title: string; description?: string };
}
const { title, description } = Astro.props.frontmatter;
---

<Base title={title} description={description}>
  <article class="max-w-wide mx-auto px-4 pt-10">
    <div class="md:ms-[8.75rem] max-w-content">
      <h1 class="text-4xl font-bold sm:text-5xl">{title}</h1>
      <div class="prose mt-8">
        <slot />
      </div>
    </div>
  </article>
</Base>
