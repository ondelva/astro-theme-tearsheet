---
import type { ComponentProps } from 'astro/types';
import { Font } from 'astro:assets';
import '../styles/global.css';
import SEO from '../components/common/SEO.astro';
import Header from '../components/common/Header.astro';
import Footer from '../components/common/Footer.astro';
import DemoBar from '../components/common/DemoBar.astro';
import Analytics from '../components/common/Analytics.astro';
import { site, ui } from '../config';

type Props = ComponentProps<typeof SEO> & {
  home?: boolean; // the home masthead prints the name, so the header drops it
};
const { home, ...seo } = Astro.props;
---

<html lang={Astro.currentLocale ?? site.locale}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    <SEO {...seo} />
    {/* Preload what the first screen sets: body 400 and the heading face's 500 (archive rows,
        meta), 700 and 800. A face that is not preloaded swaps in late and shifts the page; where
        Arial is missing (Linux, Android) the metric-matched fallback does not apply either. */}
    <Font cssVariable="--font-body" preload={[{ weight: '400', style: 'normal' }]} />
    <Font
      cssVariable="--font-heading"
      preload={[
        { weight: '500', style: 'normal' },
        { weight: '700', style: 'normal' },
        { weight: '800', style: 'normal' },
      ]}
    />
    <script is:inline>
      // Before first paint, or the page flashes the system theme.
      try {
        const saved = localStorage.getItem('theme');
        if (saved === 'light' || saved === 'dark')
          document.documentElement.setAttribute('data-theme', saved);
      } catch {}
    </script>
    <Analytics />
  </head>
  <body class="bg-background text-foreground flex min-h-screen flex-col">
    <a
      href="#main"
      class="bg-foreground text-background font-ui sr-only z-50 text-sm no-underline focus:fixed focus:top-4 focus:left-4 focus:not-sr-only focus:px-4 focus:py-2"
    >
      {ui.skipToContent}
    </a>
    <DemoBar />
    <Header home={home} />
    <main id="main" tabindex="-1" class="flex-1 outline-none">
      <slot />
    </main>
    <Footer />
  </body>
</html>
