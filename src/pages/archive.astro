---
import Base from '../layouts/Base.astro';
import YearLedger from '../components/issue/YearLedger.astro';
import { formatDate, getIssues, topicHref, topicsOf } from '../lib/issues';

const issues = await getIssues();
const members = issues.filter((i) => i.cut.members).length;
const first = issues.at(-1);
const topics = topicsOf(issues);
---

<Base title="Archive" description={`Every issue, ${issues.length} so far.`}>
  <div class="max-w-wide mx-auto px-4 pt-10">
    <header class="md:ms-[8.75rem] max-w-content">
      <h1 class="text-4xl font-bold sm:text-5xl">Archive</h1>
      {first && (
        <p class="font-ui text-muted mt-3 font-medium tabular-nums">
          {issues.length} issues since {formatDate(first.data.date)} · {members} for members. The
          bar shows how much of each issue is free.
        </p>
      )}
      {topics.length > 0 && (
        <nav aria-label="Topics" class="font-ui mt-4">
          <ul class="flex flex-wrap gap-x-5 gap-y-1">
            {topics.map(({ name, count }) => (
              <li>
                <a href={topicHref(name)} class="underline">
                  {name}
                </a>{' '}
                <span class="text-muted tabular-nums">{count}</span>
              </li>
            ))}
          </ul>
        </nav>
      )}
    </header>
    <YearLedger issues={issues} />
  </div>
</Base>
