---
// A reading list for new subscribers: a few issues per heading, picked by id. An id that no
// longer exists (or is a draft) is skipped, so deleting an issue never breaks this page.
import Base from '../layouts/Base.astro';
import Ledger from '../components/issue/Ledger.astro';
import { site } from '../config';
import { getIssues } from '../lib/issues';

const shelves = [
  {
    title: 'How to read it',
    ids: [
      'why-i-read-schedules-before-press-releases',
      'how-an-issue-is-put-together',
      'five-things-in-the-schedule-data',
    ],
  },
  {
    title: 'If you buy freight',
    ids: [
      'the-long-life-of-a-single-quote',
      'four-reader-questions-about-contract-renewals',
      'what-the-bunker-surcharge-hides',
    ],
  },
  {
    title: 'The bigger picture',
    ids: ['the-suez-detour-is-now-the-base-case', 'the-oldest-ship-on-the-loop'],
  },
];
const issues = await getIssues();
const picked = shelves
  .map((s) => ({ ...s, issues: s.ids.flatMap((id) => issues.filter((i) => i.id === id)) }))
  .filter((s) => s.issues.length > 0);
// None of the ids left (the demo issues were replaced): the latest five, until you pick your own.
const filled = picked.length ? picked : [{ title: 'The latest', issues: issues.slice(0, 5) }];
---

<Base title="Start here" description={`Where to begin with ${site.name}: a short reading list.`}>
  <div class="max-w-wide mx-auto px-4 pt-10">
    <div class="md:ms-[8.75rem] max-w-content">
      <h1 class="text-4xl font-bold sm:text-5xl">Start here</h1>
      <p class="mt-4 text-lg">
        {issues.length} issues is a lot to read backwards. These are the ones I send to people who
        ask where to begin. The bar on each row shows how much of it is free.
      </p>
      {filled.map((shelf) => (
        <section class="mt-12">
          <h2 class="text-2xl font-bold">{shelf.title}</h2>
          <div class="mt-4">
            <Ledger issues={shelf.issues} />
          </div>
        </section>
      ))}
    </div>
  </div>
</Base>
