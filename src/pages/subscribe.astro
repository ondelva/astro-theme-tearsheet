---
import Base from '../layouts/Base.astro';
import Ledger from '../components/issue/Ledger.astro';
import SubscribeForm from '../components/issue/SubscribeForm.astro';
import { newsletter, plans, ui } from '../config';

const t = ui.subscribe;
import { getIssues } from '../lib/issues';

const samples = (await getIssues()).filter((i) => !i.cut.members).slice(0, 3);
---

<Base title={t.title} description={t.description}>
  <div class="max-w-wide mx-auto px-4 pt-10">
    <div class="md:ms-[8.75rem] max-w-content">
      <h1 class="text-4xl font-bold sm:text-5xl">{t.title}</h1>
      <p class="mt-4 text-lg">{t.intro(newsletter.cadence)}</p>

      <table class="plans font-ui mt-10 w-full tabular-nums">
        <caption class="sr-only">{t.plans}</caption>
        <thead>
          <tr>
            <th scope="col">{t.plan}</th>
            <th scope="col">{t.price}</th>
            <th scope="col">{t.get}</th>
          </tr>
        </thead>
        <tbody>
          {plans.map((plan) => (
            <tr>
              <th scope="row">{plan.name}</th>
              <td class="whitespace-nowrap">{plan.price}</td>
              <td class="font-prose">{plan.detail}</td>
            </tr>
          ))}
        </tbody>
      </table>

      <div class="mt-8">
        <SubscribeForm />
      </div>

      {samples.length > 0 && (
        <section aria-labelledby="samples" class="mt-16">
          <h2 id="samples" class="text-2xl font-bold">
            {t.samples}
          </h2>
          <div class="mt-4">
            <Ledger issues={samples} />
          </div>
        </section>
      )}
    </div>
  </div>
</Base>

<style>
  .plans {
    border-collapse: collapse;
  }
  thead {
    border-bottom: 3px solid var(--foreground);
  }
  tbody tr {
    border-bottom: 1px solid var(--border);
  }
  th,
  td {
    padding: 0.75rem 1rem 0.75rem 0;
    text-align: start;
    vertical-align: baseline;
  }
  thead th {
    font-weight: 500;
    color: var(--muted);
  }
  tbody th {
    font-size: 1.25rem;
    font-weight: 800;
  }
  @media (max-width: 40rem) {
    /* Stack the detail under plan and price rather than squeeze three columns */
    thead {
      display: none;
    }
    tbody tr {
      display: grid;
      grid-template-columns: auto 1fr;
      column-gap: 1rem;
      padding-block: 0.75rem;
    }
    tbody :is(th, td) {
      padding: 0;
    }
    tbody td:last-child {
      grid-column: 1 / -1;
      margin-top: 0.25rem;
    }
  }
</style>
