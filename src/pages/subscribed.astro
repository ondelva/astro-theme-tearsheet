---
// Where a subscriber lands after the form. Point your provider's "after signup" redirect here
// (Buttondown: Settings > Subscribing; most providers have the same setting). Demo builds
// (DEMO_FORMS=1) send the form here directly and nothing is subscribed.
import Base from '../layouts/Base.astro';
import Ledger from '../components/issue/Ledger.astro';
import { ui } from '../config';
import { getIssues } from '../lib/issues';

const demo = import.meta.env.DEMO_FORMS === '1';
const t = ui.subscribed;
const samples = (await getIssues()).filter((i) => !i.cut.members).slice(0, 3);
---

<Base title={t.title} description={t.description} noindex>
  <div class="max-w-wide mx-auto px-4 pt-10">
    <div class="max-w-content md:ms-[8.75rem]">
      <h1 class="text-4xl font-bold sm:text-5xl">{t.title}</h1>
      {demo ? <p class="mt-4 text-lg">{t.demo}</p> : <p class="mt-4 text-lg">{t.text}</p>}
      {samples.length > 0 && (
        <section aria-labelledby="meanwhile" class="mt-12">
          <h2 id="meanwhile" class="text-2xl font-bold">
            {t.meanwhile}
          </h2>
          <div class="mt-4">
            <Ledger issues={samples} />
          </div>
        </section>
      )}
    </div>
  </div>
</Base>
