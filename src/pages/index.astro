---
import Base from '../layouts/Base.astro';
import IssueHead from '../components/issue/IssueHead.astro';
import TheCut from '../components/issue/TheCut.astro';
import Ledger from '../components/issue/Ledger.astro';
import SubscribeForm from '../components/issue/SubscribeForm.astro';
import { newsletter, site } from '../config';
import { getIssues, issueHref } from '../lib/issues';

const [latest, ...rest] = await getIssues();
const recent = rest.slice(0, newsletter.homeRecent);
---

<Base description={site.description} home>
  <div class="max-w-wide mx-auto px-4">
    <header class="border-foreground font-ui border-b-[3px] pt-10 pb-3">
      <h1 class="text-5xl leading-none font-extrabold sm:text-7xl">{site.name}</h1>
      <p class="text-muted mt-3 flex flex-wrap justify-between gap-x-6 font-medium">
        <span>{site.description}</span>
        <span>
          {newsletter.cadence} · by {site.author}
        </span>
      </p>
    </header>

    {latest && (
      <section aria-label="Latest issue" class="mt-12">
        <IssueHead issue={latest} link>
          <div class="max-w-content">
            {latest.cut.members ? (
              <TheCut cut={latest.cut} href={issueHref(latest)} />
            ) : (
              <p class="font-ui mt-6 font-bold">
                <a href={issueHref(latest)} class="underline">
                  Read issue {latest.number}
                </a>
              </p>
            )}
          </div>
        </IssueHead>
      </section>
    )}

    {recent.length > 0 && (
      <section aria-labelledby="recent" class="mt-16 md:ms-[8.75rem]">
        <div class="max-w-content">
          <h2 id="recent" class="text-2xl font-bold">
            Recent issues
          </h2>
          <p class="font-ui text-muted mt-1">The bar shows how much of each issue is free.</p>
          <div class="mt-4">
            <Ledger issues={recent} />
          </div>
          <p class="font-ui mt-4 font-medium">
            <a href="/archive" class="underline">
              Full archive
            </a>
          </p>
        </div>
      </section>
    )}

    <section aria-labelledby="subscribe" class="mt-16 md:ms-[8.75rem]">
      <div class="max-w-content">
        <h2 id="subscribe" class="text-2xl font-bold">
          Subscribe
        </h2>
        <p class="mt-2">
          {newsletter.cadence}, one issue. Free issues go to everyone on the list; members get every
          issue in full for {newsletter.price}.
        </p>
        <div class="mt-4">
          <SubscribeForm />
        </div>
      </div>
    </section>
  </div>
</Base>
